# PostgreSQL direct (postgresql://) or Prisma Accelerate (prisma:// or prisma+postgres://).
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your-api-key"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Server-only xAI credential. No Vercel AI Gateway required.
GROK_API_KEY=""
# Google data sources have no paid SEO subscription; Grok calls are billed by xAI.
# Enable only after authentication and xAI billing are configured.
SEO_LIVE_ENABLED="false"
# xAI model ID, not an API key and not a provider-prefixed Gateway ID.
SEO_MODEL="grok-4.6"
GOOGLE_PAGESPEED_API_KEY=""
# Optional free CrUX API / CrUX History API (subject to Google quotas).
GOOGLE_CRUX_API_KEY=""
# GA4 reports use Google OAuth above and the property selected in the app.
# No GOOGLE_ANALYTICS_API_KEY is needed. Enable Analytics Admin API + Analytics Data API.
